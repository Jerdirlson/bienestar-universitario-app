# Plantilla de variables de entorno. Copiar a .env y llenar con valores reales.
#
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA debe commitearse.
# En Expo, solo las variables con prefijo EXPO_PUBLIC_ llegan al cliente.

# ── Supabase ────────────────────────────────────────────────────────────────
# Se obtienen del panel del proyecto, en Settings → API.
# Todavía no existe el proyecto: ver supabase/README.md.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ATENCIÓN: la llave `service_role` NO va aquí ni en ninguna variable
# EXPO_PUBLIC_. Pasa por encima de todas las políticas de seguridad de la base
# de datos, así que solo vive en el backend de moderación, en un gestor de
# secretos. Si llega al cliente, cualquiera puede leer todos los diarios.

# ── Sentry (reporte de errores) ─────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ── API de Raíz ─────────────────────────────────────────────────────────────
# URL pública de raiz-api. Hoy es el túnel de Cloudflare del despliegue de
# prueba (deploy/docker-compose.yml, servicio tunnel) — cambia si ese
# contenedor se reinicia. Verla con: docker logs raiz-tunnel | grep trycloudflare
EXPO_PUBLIC_API_URL=

# Configuración del API de Raíz.
#
#   cp .env.example .env
#
# .env está en .gitignore. El repositorio es PÚBLICO: nunca commitearlo.

# Rol de APLICACIÓN (raiz_app), no el dueño de la base.
# El dueño no está sujeto a las políticas de seguridad — ver deploy/README.md.
# El host `db` es el nombre del servicio dentro de la red de Docker.
DATABASE_URL=postgresql://raiz_app:CONTRASENA@db:5432/raiz

# Firma de los tokens de sesión.  openssl rand -base64 48
JWT_SECRET=

# Solo se aceptan correos de este dominio al pedir código de acceso.
ALLOWED_EMAIL_DOMAIN=upb.edu.co

# ── Envío del código (SMTP) ──────────────────────────────────────────────────
# Sin proveedor institucional todavía. Para el piloto alcanza cualquier cuenta
# SMTP, incluida una de Gmail normal con una "contraseña de aplicación":
# https://myaccount.google.com/apppasswords (no la contraseña de la cuenta).
# En NODE_ENV=production, si esto falta, /auth/request-code falla ruidoso en
# vez de fingir que envió un correo que nunca llega. Ver src/mailer.js.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PORT=3000
NODE_ENV=production
